<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/white"
              android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/settings_title"
            app:titleTextColor="@color/white" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

            <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/spacing_lg">

                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_avatar_placeholder"
                        android:padding="20dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                <ImageView
                        android:id="@+id/btnEditPhoto"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_button_send"
                        android:contentDescription="@string/change_photo"
                        android:padding="6dp"
                        android:src="@drawable/ic_attach_image"
                        app:tint="@color/white" />

            </FrameLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="@string/username"
                    android:textColor="@color/gray_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/username"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/accent_color"
                    android:textColor="@color/gray_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            <LinearLayout
                    android:id="@+id/colorSwatchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                <View
                        android:id="@+id/swatchBlue"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_swatch_blue" />

                <View
                        android:id="@+id/swatchRed"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_swatch_red" />

                <View
                        android:id="@+id/swatchGreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_swatch_green" />

                <View
                        android:id="@+id/swatchYellow"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_swatch_yellow" />

            </LinearLayout>

            <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_send"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>