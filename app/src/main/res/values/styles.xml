<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Message.Sent" parent="android:TextAppearance">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Message.Received" parent="android:TextAppearance">
        <item name="android:textColor">@color/gray_900</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Time" parent="android:TextAppearance">
        <item name="android:textColor">@color/gray_500</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>